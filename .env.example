# Get your Google Gemini API Key here https://cloud.google.com/vertex-ai
GOOGLE_GENERATIVE_AI_API_KEY=****

# Generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# MCP Server Configuration (for real-time financial data and web intelligence)
#
# To enable real-time financial data, you need an endpoint for the PlusE Finance MCP.
# Get your free endpoint by signing up at https://plusefin.com
MCP_SERVER_URL_PLUSE=****
#
# To enable web intelligence for market news and sentiment, you need an endpoint for the Tavily API.
# Get your endpoint from https://www.tavily.com
MCP_SERVER_URL_TAVILY=****

/*
 * The following keys below are automatically created and
 * added to your environment when you deploy on vercel
 */

# Instructions to create kv database here: https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# Instructions to create a database here: https://vercel.com/docs/storage/vercel-postgres/quickstart
POSTGRES_URL=****
